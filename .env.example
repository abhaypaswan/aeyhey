# Aeyhey configuration. Every value here is optional: the app runs with no edits.
# Copy to .env and change what you need. Never commit your .env file.
# Env values override the in-app settings, and the UI shows which ones are locked.

# ---------- core ----------
# Used for links in push and Telegram, and for the Telegram webhook URL.
PUBLIC_URL=http://localhost:3000
# Cookie signing, token HMAC and API key encryption.
# Left empty, it is generated on first run and saved to DATA_DIR/secrets.json.
APP_SECRET=
# SQLite file path, or a postgres:// URL to use Postgres instead.
DATABASE_URL=file:/data/aeyhey.db
# Postgres only: connections per process (default 10). A transaction pooler is spotted by
# port 6543 or ?pgbouncer=true, and prepared statements are then turned off.
# DATABASE_POOL_MAX=10
# Uploads, generated secrets and the SQLite file live here.
DATA_DIR=/data
LOG_LEVEL=info

# ---------- demo ----------
# true loads seed data and the mock AI provider. No API key needed.
DEMO_MODE=false

# ---------- auth ----------
# password, or none for a trusted LAN only (the app logs a warning).
AUTH_MODE=password
# Where a phone app may be sent back to after signing in at /connect. Comma separated,
# matched exactly. Empty means aeyhey://auth.
API_REDIRECT_URIS=
# Optional preset owner, so first run needs no setup screen.
OWNER_EMAIL=
OWNER_PASSWORD=

# ---------- ai ----------
# openai, anthropic, ollama or mock. Leave empty to set it in the UI.
AI_PROVIDER=
# Any OpenAI-compatible endpoint works here (OpenRouter, Groq, LM Studio, vLLM).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# One model per task. Empty falls back to the per-provider default in code.
AI_MODEL_SUMMARY=
AI_MODEL_GENERATE=
AI_MODEL_GRADE=
AI_MAX_CONCURRENCY=3
AI_RPM=30

# ---------- web push ----------
# Generated on first run if empty, then saved to DATA_DIR/secrets.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# ---------- telegram ----------
# Set a bot token from @BotFather to turn Telegram on.
TELEGRAM_BOT_TOKEN=
# webhook, polling or auto. auto picks webhook when PUBLIC_URL is https.
TELEGRAM_MODE=auto
# Derived from APP_SECRET when empty.
TELEGRAM_WEBHOOK_SECRET=

# ---------- link fetching ----------
FETCH_TIMEOUT_MS=15000
# true lets the app fetch private network addresses. Only for trusted setups.
FETCH_ALLOW_PRIVATE=false
MAX_UPLOAD_MB=5

# ---------- editions ----------
# community or hosted. This picks default feature flags only.
# Setting hosted here without the hosted plugin makes the app fail fast at startup.
EDITION=community
# Optional flag overrides, for example byoKeys=false,ollama=true
FEATURE_FLAGS=
