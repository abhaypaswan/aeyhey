{
  "name": "@aeyhey/core",
  "version": "0.4.15",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Aeyhey core: schema, scheduler, AI layer, jobs, notifications and extension points.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./extensions": "./src/extensions/index.ts",
    "./db": "./src/db/index.ts",
    "./scheduler": "./src/scheduler/index.ts",
    "./links": "./src/links/index.ts",
    "./questions": "./src/questions/index.ts",
    "./ai": "./src/ai/index.ts",
    "./jobs": "./src/jobs/index.ts",
    "./notify": "./src/notify/index.ts",
    "./repos": "./src/repos/index.ts",
    "./security": "./src/security/index.ts",
    "./search": "./src/search/index.ts",
    "./seed": "./src/seed/index.ts",
    "./api": "./src/api/index.ts",
    "./sessions": "./src/sessions/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/cli-migrate.ts",
    "demo:seed": "tsx src/seed/cli-seed.ts",
    "demo:reset": "tsx src/seed/cli-seed.ts --reset",
    "api:spec": "tsx src/api/cli-openapi.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@mozilla/readability": "^0.5.0",
    "@node-rs/argon2": "^2.0.2",
    "ai": "^5.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.32.0",
    "linkedom": "^0.18.5",
    "mammoth": "^1.8.0",
    "rehype-sanitize": "^6.0.0",
    "ts-fsrs": "^6.0.0",
    "ulid": "^2.3.0",
    "undici": "^6.21.0",
    "unpdf": "^0.12.1",
    "web-push": "^3.6.7",
    "youtube-transcript": "^1.2.1",
    "zod": "^4.1.8"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.5.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "msw": "^2.6.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
